# Address of the backend API. Leave empty in development: Vite forwards /api to
# the local backend (vite.config.ts). For a hosted site, the backend's address,
# e.g. https://trityanetra-api.onrender.com (no trailing slash).
VITE_API_BASE_URL=

# Request timeout in milliseconds (optional).
VITE_API_TIMEOUT_MS=
