# Copy to .env and fill in real values. Never commit .env.
# Names only here; no real secrets in this file.

# --- Required (server throws at startup if missing, except PORT) ---
PORT=5001
JWT_SECRET=change-me-to-a-long-random-string
REDIS_URL=redis://localhost:6379
AST_ENGINE_URL=http://localhost:8000
AST_ENGINE_SECRET=must-match-the-AST-engine-X-Internal-Secret

# --- Judge0 code execution ---
# JUDGE0_API_URL + JUDGE0_API_KEY enable code execution. Works with self-hosted Judge0 CE (X-Auth-Token)
# or RapidAPI's Judge0 CE (https://judge0-ce.p.rapidapi.com) - the key header is detected automatically.
# SYNC mode (default, works on localhost): leave JUDGE0_CALLBACK_* blank; the server waits for the result.
# ASYNC mode (needs a PUBLIC backend URL): set JUDGE0_CALLBACK_BASE_URL + JUDGE0_CALLBACK_TOKEN; Judge0
# calls back with the result instead of the server waiting.
JUDGE0_API_URL=
JUDGE0_API_KEY=
# Secret placed in the callback URL given to Judge0: <public url>/api/judge0/callback/<this value>
# One value per environment, shared by direct message only, never committed.
JUDGE0_CALLBACK_TOKEN=
# Public URL that Judge0 can reach this backend at (must be reachable from the Judge0 server, not localhost
# unless Judge0 runs on the same machine). Callbacks go to <this>/api/judge0/callback/<token>?run=<run id>
JUDGE0_CALLBACK_BASE_URL=

# --- Email verification ---
# Public URL of the frontend, used in the verification link (default http://localhost:3000).
APP_BASE_URL=http://localhost:3000
# SMTP connection string to actually send mail, e.g. smtps://user:pass@smtp.gmail.com:465
# If unset, mail is NOT sent: in dev the link is printed to the backend console instead.
SMTP_URL=
MAIL_FROM=Trityanetra <no-reply@trityanetra.local>

# --- Optional: only for scripts/bootstrap-admin.ts ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Firebase credentials are NOT set here: place the service account key at
# backend/config/serviceAccountKey.json (git-ignored).
# Emulator vars (FIRESTORE_EMULATOR_HOST etc.) are set by the test setup, not needed here.
