NODE_ENV=development
PORT=3001

# Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Judge0
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_RATE_LIMIT_MAX=30
JUDGE0_RATE_LIMIT_WINDOW_MS=60000
JUDGE0_CIRCUIT_BREAKER_THRESHOLD=5
JUDGE0_CIRCUIT_BREAKER_RESET_MS=30000

# Monitor
MONITOR_RATE_LIMIT_MAX=20
MONITOR_RATE_LIMIT_WINDOW_MS=60000

# AST Engine
AST_ENGINE_URL=http://localhost:8000
AST_ENGINE_INTERNAL_SECRET=your-internal-secret

# JWT
JWT_SECRET=dev-secret-change-in-production

# CORS
CORS_ORIGIN=http://localhost:5173
